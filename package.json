{
  "name": "stageforge-3d",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:desktop": "playwright test -c playwright.desktop.config.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:prepare": "tsc && vite build --base ./ --outDir desktop/build/app/renderer --emptyOutDir && node desktop/prepare.mjs",
    "desktop:start": "npm run desktop:prepare && electron desktop/build/app",
    "desktop:win": "npm run desktop:prepare && electron-builder --config desktop/builder.cjs --win portable --x64 --publish never",
    "desktop:mac": "npm run desktop:prepare && electron-builder --config desktop/builder.cjs --mac zip --arm64 --publish never"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "2.10.1",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "realtime-bpm-analyzer": "6.3.0",
    "three": "0.187.0",
    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "license": "MIT"
}
