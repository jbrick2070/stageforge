{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jbrick2070.github.io/stageforge/schemas/show-v7.schema.json",
  "title": "StageForge show, version 7",
  "description": "Open StageForge show with ordered cues, the current desk, optional timed playback, MVR interchange, SMPTE metadata, real equipment catalogue references, and rigging/power specifications (truss profiles, hoist ratings, box hoist counts, dimmer/circuit groups, phase pins, and electrical system). Cross-field rules also checked by the reader: unique IDs per list, valid cue and rig references, nondecreasing event times within the duration, ordered motor limits, 0.25 m minimum truss segments, at most 1,024 fixtures, catalogId requiring dmxMode and dmxChannels, hoistCount allowed only on box trusses, and unique targets in rig.power.pins.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://jbrick2070.github.io/stageforge/schemas/show-v7.schema.json"
    },
    "format": {
      "const": "stageforge-show"
    },
    "version": {
      "const": 7
    },
    "rig": {
      "$ref": "#/$defs/rig"
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      },
      "maxItems": 4096
    },
    "look": {
      "$ref": "#/$defs/look"
    },
    "activeCueId": {
      "type": [
        "null",
        "string"
      ],
      "description": "Null, or an ID from cues."
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "stage": {
      "$ref": "#/$defs/nativeStage"
    },
    "interchange": {
      "$ref": "#/$defs/interchange"
    }
  },
  "required": [
    "$schema",
    "format",
    "version",
    "rig",
    "cues",
    "look",
    "activeCueId"
  ],
  "additionalProperties": false,
  "$defs": {
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!(?:__proto__|prototype|constructor)$)(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "label": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "coordinate": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "dimension": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "rig": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "venue": {
          "enum": [
            "arena",
            "warehouse",
            "festival",
            "theatre",
            "club"
          ]
        },
        "stageWidth": {
          "$ref": "#/$defs/dimension"
        },
        "stageDepth": {
          "$ref": "#/$defs/dimension"
        },
        "stageHeight": {
          "$ref": "#/$defs/dimension"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          },
          "maxItems": 24
        },
        "ledWall": {
          "$ref": "#/$defs/wall"
        },
        "audioRig": {
          "$ref": "#/$defs/audioRig"
        },
        "trussPods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pod"
          },
          "maxItems": 256
        },
        "floorFx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/floorFx"
          },
          "maxItems": 1024
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prop"
          },
          "maxItems": 256
        },
        "power": {
          "$ref": "#/$defs/rigPower"
        }
      },
      "required": [
        "name",
        "venue",
        "stageWidth",
        "stageDepth",
        "stageHeight",
        "ledWall",
        "audioRig",
        "trussPods",
        "floorFx"
      ],
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "curved": {
          "type": "boolean"
        },
        "sideWings": {
          "type": "boolean"
        },
        "cabinets": {
          "$ref": "#/$defs/ledCabinets"
        }
      },
      "required": [
        "enabled",
        "width",
        "height",
        "curved",
        "sideWings"
      ],
      "additionalProperties": false
    },
    "ledCabinets": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "widthMm": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000
        },
        "heightMm": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000
        },
        "pixelsWide": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "pixelsHigh": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "cabinetId": {
          "$ref": "#/$defs/catalogId"
        }
      },
      "required": [
        "columns",
        "rows",
        "widthMm",
        "heightMm",
        "pixelsWide",
        "pixelsHigh"
      ],
      "additionalProperties": false
    },
    "audioRig": {
      "type": "object",
      "properties": {
        "lineArrays": {
          "type": "boolean"
        },
        "speakerProfile": {
          "enum": [
            "touring",
            "k2"
          ]
        },
        "boxesPerSide": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "monitorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "subWall": {
          "type": "boolean"
        },
        "subCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "djBooth": {
          "type": "boolean"
        },
        "crowdDensity": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "lineArrays",
        "subWall",
        "subCount",
        "djBooth",
        "crowdDensity"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "depth": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "z",
        "width",
        "depth",
        "height"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false
    },
    "pod": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "shape": {
          "enum": [
            "box",
            "circle",
            "chevron",
            "path"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 64,
          "minItems": 2
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "baseY": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "rotationY": {
          "type": "number"
        },
        "motorized": {
          "type": "boolean"
        },
        "motorMinY": {
          "$ref": "#/$defs/coordinate"
        },
        "motorMaxY": {
          "$ref": "#/$defs/coordinate"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          },
          "maxItems": 512
        },
        "trussProfileId": {
          "$ref": "#/$defs/catalogId"
        },
        "hoistId": {
          "$ref": "#/$defs/catalogId"
        },
        "hoistCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      },
      "required": [
        "id",
        "name",
        "shape",
        "width",
        "x",
        "baseY",
        "z",
        "rotationY",
        "motorized",
        "motorMinY",
        "motorMaxY",
        "fixtures"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "shape": {
            "const": "path"
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    "fixtureOptics": {
      "type": "object",
      "properties": {
        "lumens": {
          "$ref": "#/$defs/fixtureLumens"
        },
        "beamAngle": {
          "$ref": "#/$defs/fixtureBeamAngle"
        },
        "profile": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "datasheet"
              ]
            },
            "manufacturer": {
              "$ref": "#/$defs/label"
            },
            "fixture": {
              "$ref": "#/$defs/label"
            },
            "geometry": {
              "$ref": "#/$defs/label"
            },
            "lumens": {
              "$ref": "#/$defs/fixtureLumens"
            },
            "beamAngle": {
              "$ref": "#/$defs/fixtureBeamAngle"
            }
          },
          "required": [
            "manufacturer",
            "fixture",
            "geometry"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fixtureLumens": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "fixtureBeamAngle": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 179
    },
    "fixture": {
      "type": "object",
      "properties": {
        "optics": {
          "$ref": "#/$defs/fixtureOptics"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "modelName": {
          "$ref": "#/$defs/label"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "dmxUniverse": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "dmxStartChannel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "type": {
          "enum": [
            "beam",
            "wash",
            "laser",
            "strobe",
            "blinder"
          ]
        },
        "catalogId": {
          "$ref": "#/$defs/catalogId"
        },
        "dmxMode": {
          "$ref": "#/$defs/dmxMode"
        },
        "dmxChannels": {
          "$ref": "#/$defs/dmxChannels"
        },
        "circuitGroup": {
          "$ref": "#/$defs/circuitGroup"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        }
      },
      "required": [
        "id",
        "modelName",
        "count",
        "dmxUniverse",
        "dmxStartChannel",
        "type"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "catalogId": [
          "dmxMode",
          "dmxChannels"
        ]
      }
    },
    "floorFx": {
      "type": "object",
      "properties": {
        "optics": {
          "$ref": "#/$defs/fixtureOptics"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "modelName": {
          "$ref": "#/$defs/label"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "dmxUniverse": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "dmxStartChannel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "type": {
          "enum": [
            "hazer",
            "smoke",
            "co2",
            "floor_laser",
            "floor_beam"
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "catalogId": {
          "$ref": "#/$defs/catalogId"
        },
        "dmxMode": {
          "$ref": "#/$defs/dmxMode"
        },
        "dmxChannels": {
          "$ref": "#/$defs/dmxChannels"
        },
        "circuitGroup": {
          "$ref": "#/$defs/circuitGroup"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        }
      },
      "required": [
        "id",
        "modelName",
        "count",
        "dmxUniverse",
        "dmxStartChannel",
        "type",
        "x",
        "z",
        "spread"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "catalogId": [
          "dmxMode",
          "dmxChannels"
        ]
      }
    },
    "prop": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "tentacle",
            "star",
            "arch",
            "marquee",
            "riser"
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "scale": {
          "type": "number",
          "minimum": 0.35,
          "maximum": 2
        },
        "rotation": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "z",
        "scale",
        "rotation",
        "color"
      ],
      "additionalProperties": false
    },
    "headGroup": {
      "type": "object",
      "properties": {
        "movementMode": {
          "enum": [
            "manual",
            "fan",
            "sweep",
            "circle",
            "figure8",
            "flyout",
            "wave",
            "ballyhoo",
            "crowd_scan"
          ]
        },
        "movementSpeed": {
          "$ref": "#/$defs/unit"
        },
        "movementSpread": {
          "$ref": "#/$defs/unit"
        },
        "manualPan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "manualTilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "focusMarkId": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 1,
          "maxLength": 265,
          "description": "An available platform:<id> focus point, audience, or null."
        },
        "primaryColor": {
          "$ref": "#/$defs/color"
        },
        "accentColor": {
          "$ref": "#/$defs/color"
        },
        "colorSplitMode": {
          "enum": [
            "solid",
            "alternate",
            "gradient",
            "rainbow"
          ]
        }
      },
      "additionalProperties": false
    },
    "look": {
      "$ref": "#/$defs/cueState",
      "required": [
        "masterDimmer",
        "blackout",
        "autoDirector",
        "audioReactive",
        "bpm",
        "beamIntensity",
        "washIntensity",
        "beamZoom",
        "goboPrism",
        "primaryColor",
        "accentColor",
        "colorSplitMode",
        "movementMode",
        "movementSpeed",
        "movementSpread",
        "manualPan",
        "manualTilt",
        "strobeRate",
        "blinderLevel",
        "laser",
        "motors",
        "atmo",
        "led",
        "bloomStrength"
      ]
    },
    "cueState": {
      "type": "object",
      "properties": {
        "masterDimmer": {
          "$ref": "#/$defs/unit"
        },
        "blackout": {
          "type": "boolean"
        },
        "autoDirector": {
          "type": "boolean"
        },
        "audioReactive": {
          "type": "boolean"
        },
        "bpm": {
          "type": "number",
          "minimum": 70,
          "maximum": 180
        },
        "beamIntensity": {
          "$ref": "#/$defs/unit"
        },
        "washIntensity": {
          "$ref": "#/$defs/unit"
        },
        "beamZoom": {
          "$ref": "#/$defs/unit"
        },
        "goboPrism": {
          "type": "boolean"
        },
        "primaryColor": {
          "$ref": "#/$defs/color"
        },
        "accentColor": {
          "$ref": "#/$defs/color"
        },
        "movingGroups": {
          "type": "object",
          "properties": {
            "beam": {
              "$ref": "#/$defs/headGroup"
            },
            "wash": {
              "$ref": "#/$defs/headGroup"
            }
          },
          "additionalProperties": false
        },
        "colorSplitMode": {
          "enum": [
            "solid",
            "alternate",
            "gradient",
            "rainbow"
          ]
        },
        "movementMode": {
          "enum": [
            "manual",
            "fan",
            "sweep",
            "circle",
            "figure8",
            "flyout",
            "wave",
            "ballyhoo",
            "crowd_scan"
          ]
        },
        "movementSpeed": {
          "$ref": "#/$defs/unit"
        },
        "movementSpread": {
          "$ref": "#/$defs/unit"
        },
        "manualPan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "manualTilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "focusMarkId": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 1,
          "maxLength": 265,
          "description": "An available platform:<id> focus point, audience, or null."
        },
        "strobeRate": {
          "$ref": "#/$defs/unit"
        },
        "blinderLevel": {
          "$ref": "#/$defs/unit"
        },
        "laser": {
          "$ref": "#/$defs/laser"
        },
        "motors": {
          "$ref": "#/$defs/motors"
        },
        "atmo": {
          "$ref": "#/$defs/atmo"
        },
        "led": {
          "$ref": "#/$defs/led"
        },
        "bloomStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "description": "Only supplied desk fields change when firing a cue. Each supplied subsystem is a complete object."
    },
    "laserBeamCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "laserSegments": {
      "enum": [
        8,
        16,
        48,
        96
      ]
    },
    "laserColorMode": {
      "enum": [
        "primary",
        "dual",
        "rainbow",
        "cyan_magenta",
        "emerald_gold",
        "crimson_ice",
        "custom",
        "custom_dual"
      ]
    },
    "laserProjectorLook": {
      "type": "object",
      "properties": {
        "beamCount": {
          "$ref": "#/$defs/laserBeamCount"
        },
        "patternSegments": {
          "$ref": "#/$defs/laserSegments"
        },
        "colorMode": {
          "$ref": "#/$defs/laserColorMode"
        },
        "colorA": {
          "$ref": "#/$defs/color"
        },
        "colorB": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": false
    },
    "laser": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intensity": {
          "$ref": "#/$defs/unit"
        },
        "pattern": {
          "enum": [
            "liquid_sky",
            "tunnel",
            "fan",
            "wave",
            "matrix",
            "starburst",
            "horizon",
            "dual_cones"
          ]
        },
        "beamCount": {
          "$ref": "#/$defs/laserBeamCount"
        },
        "patternSegments": {
          "$ref": "#/$defs/laserSegments"
        },
        "colorA": {
          "$ref": "#/$defs/color"
        },
        "colorB": {
          "$ref": "#/$defs/color"
        },
        "projectors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\[",
            "maxLength": 4096
          },
          "additionalProperties": {
            "$ref": "#/$defs/laserProjectorLook"
          },
          "maxProperties": 1024
        },
        "spreadX": {
          "$ref": "#/$defs/unit"
        },
        "spreadY": {
          "$ref": "#/$defs/unit"
        },
        "speed": {
          "$ref": "#/$defs/unit"
        },
        "tilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "rotation": {
          "$ref": "#/$defs/unit"
        },
        "colorMode": {
          "$ref": "#/$defs/laserColorMode"
        },
        "strobe": {
          "$ref": "#/$defs/unit"
        },
        "audienceScan": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "intensity",
        "pattern",
        "beamCount",
        "spreadX",
        "spreadY",
        "speed",
        "tilt",
        "rotation",
        "colorMode",
        "strobe",
        "audienceScan"
      ],
      "additionalProperties": false
    },
    "motorTarget": {
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/unit"
        },
        "tilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
