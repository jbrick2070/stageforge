{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jbrick2070.github.io/stageforge/schemas/show-v1.schema.json",
  "title": "StageForge show, version 1",
  "description": "Open StageForge show with ordered cues, the current desk and optional timed playback. Cross-field rules also checked by the reader: unique IDs per list, valid cue and rig references, nondecreasing event times within the duration, ordered motor limits, 0.25 m minimum truss segments, and at most 1,024 fixtures.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://jbrick2070.github.io/stageforge/schemas/show-v1.schema.json"
    },
    "format": {
      "const": "stageforge-show"
    },
    "version": {
      "const": 1
    },
    "rig": {
      "$ref": "#/$defs/rig"
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      },
      "maxItems": 4096
    },
    "look": {
      "$ref": "#/$defs/look"
    },
    "activeCueId": {
      "type": [
        "null",
        "string"
      ],
      "description": "Null, or an ID from cues."
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "media": {
      "$ref": "#/$defs/media"
    }
  },
  "required": [
    "$schema",
    "format",
    "version",
    "rig",
    "cues",
    "look",
    "activeCueId"
  ],
  "additionalProperties": false,
  "$defs": {
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!(?:__proto__|prototype|constructor)$)(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "label": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "coordinate": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "dimension": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "rig": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "venue": {
          "enum": [
            "arena",
            "warehouse",
            "festival",
            "theatre",
            "club"
          ]
        },
        "stageWidth": {
          "$ref": "#/$defs/dimension"
        },
        "stageDepth": {
          "$ref": "#/$defs/dimension"
        },
        "stageHeight": {
          "$ref": "#/$defs/dimension"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          },
          "maxItems": 24
        },
        "ledWall": {
          "$ref": "#/$defs/wall"
        },
        "audioRig": {
          "$ref": "#/$defs/audioRig"
        },
        "trussPods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pod"
          },
          "maxItems": 64
        },
        "floorFx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/floorFx"
          },
          "maxItems": 1024
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prop"
          },
          "maxItems": 256
        }
      },
      "required": [
        "name",
        "venue",
        "stageWidth",
        "stageDepth",
        "stageHeight",
        "ledWall",
        "audioRig",
        "trussPods",
        "floorFx"
      ],
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "curved": {
          "type": "boolean"
        },
        "sideWings": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "width",
        "height",
        "curved",
        "sideWings"
      ],
      "additionalProperties": false
    },
    "audioRig": {
      "type": "object",
      "properties": {
        "lineArrays": {
          "type": "boolean"
        },
        "speakerProfile": {
          "enum": [
            "touring",
            "k2"
          ]
        },
        "boxesPerSide": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "monitorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "subWall": {
          "type": "boolean"
        },
        "subCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "djBooth": {
          "type": "boolean"
        },
        "crowdDensity": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "lineArrays",
        "subWall",
        "subCount",
        "djBooth",
        "crowdDensity"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "depth": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "z",
        "width",
        "depth",
        "height"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false
    },
    "pod": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "shape": {
          "enum": [
            "box",
            "circle",
            "chevron",
            "path"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 64,
          "minItems": 2
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "baseY": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "rotationY": {
          "type": "number"
        },
        "motorized": {
          "type": "boolean"
        },
        "motorMinY": {
          "$ref": "#/$defs/coordinate"
        },
        "motorMaxY": {
          "$ref": "#/$defs/coordinate"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          },
          "maxItems": 512
        }
      },
      "required": [
        "id",
        "name",
        "shape",
        "width",
        "x",
        "baseY",
        "z",
        "rotationY",
        "motorized",
        "motorMinY",
        "motorMaxY",
        "fixtures"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "shape": {
            "const": "path"
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "modelName": {
          "$ref": "#/$defs/label"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "dmxUniverse": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "dmxStartChannel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "type": {
          "enum": [
            "beam",
            "wash",
            "laser",
            "strobe",
            "blinder"
          ]
        }
      },
      "required": [
        "id",
        "modelName",
        "count",
        "dmxUniverse",
        "dmxStartChannel",
        "type"
      ],
      "additionalProperties": false
    },
    "floorFx": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "modelName": {
          "$ref": "#/$defs/label"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "dmxUniverse": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "dmxStartChannel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "type": {
          "enum": [
            "hazer",
            "smoke",
            "co2",
            "floor_laser",
            "floor_beam"
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "id",
        "modelName",
        "count",
        "dmxUniverse",
        "dmxStartChannel",
        "type",
        "x",
        "z",
        "spread"
      ],
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "tentacle",
            "star",
            "arch",
            "marquee",
            "riser"
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "scale": {
          "type": "number",
          "minimum": 0.35,
          "maximum": 2
        },
        "rotation": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "z",
        "scale",
        "rotation",
        "color"
      ],
      "additionalProperties": false
    },
    "look": {
      "$ref": "#/$defs/cueState",
      "required": [
        "masterDimmer",
        "blackout",
        "autoDirector",
        "audioReactive",
        "bpm",
        "beamIntensity",
        "washIntensity",
        "beamZoom",
        "goboPrism",
        "primaryColor",
        "accentColor",
        "colorSplitMode",
        "movementMode",
        "movementSpeed",
        "movementSpread",
        "manualPan",
        "manualTilt",
        "strobeRate",
        "blinderLevel",
        "laser",
        "motors",
        "atmo",
        "led",
        "bloomStrength"
      ]
    },
    "cueState": {
      "type": "object",
      "properties": {
        "masterDimmer": {
          "$ref": "#/$defs/unit"
        },
        "blackout": {
          "type": "boolean"
        },
        "autoDirector": {
          "type": "boolean"
        },
        "audioReactive": {
          "type": "boolean"
        },
        "bpm": {
          "type": "number",
          "minimum": 70,
          "maximum": 180
        },
        "beamIntensity": {
          "$ref": "#/$defs/unit"
        },
        "washIntensity": {
          "$ref": "#/$defs/unit"
        },
        "beamZoom": {
          "$ref": "#/$defs/unit"
        },
        "goboPrism": {
          "type": "boolean"
        },
        "primaryColor": {
          "$ref": "#/$defs/color"
        },
        "accentColor": {
          "$ref": "#/$defs/color"
        },
        "colorSplitMode": {
          "enum": [
            "solid",
            "alternate",
            "gradient",
            "rainbow"
          ]
        },
        "movementMode": {
          "enum": [
            "manual",
            "fan",
            "sweep",
            "circle",
            "figure8",
            "flyout",
            "wave",
            "ballyhoo",
            "crowd_scan"
          ]
        },
        "movementSpeed": {
          "$ref": "#/$defs/unit"
        },
        "movementSpread": {
          "$ref": "#/$defs/unit"
        },
        "manualPan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "manualTilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "focusMarkId": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 1,
          "maxLength": 265,
          "description": "An available platform:<id> focus point, audience, or null."
        },
        "strobeRate": {
          "$ref": "#/$defs/unit"
        },
        "blinderLevel": {
          "$ref": "#/$defs/unit"
        },
        "laser": {
          "$ref": "#/$defs/laser"
        },
        "motors": {
          "$ref": "#/$defs/motors"
        },
        "atmo": {
          "$ref": "#/$defs/atmo"
        },
        "led": {
          "$ref": "#/$defs/led"
        },
        "bloomStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "description": "Only supplied desk fields change when firing a cue. Each supplied subsystem is a complete object."
    },
    "laser": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intensity": {
          "$ref": "#/$defs/unit"
        },
        "pattern": {
          "enum": [
            "liquid_sky",
            "tunnel",
            "fan",
            "wave",
            "matrix",
            "starburst",
            "horizon",
            "dual_cones"
          ]
        },
        "beamCount": {
          "type": "integer",
          "minimum": 4,
          "maximum": 32
        },
        "spreadX": {
          "$ref": "#/$defs/unit"
        },
        "spreadY": {
          "$ref": "#/$defs/unit"
        },
        "speed": {
          "$ref": "#/$defs/unit"
        },
        "tilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "rotation": {
          "$ref": "#/$defs/unit"
        },
        "colorMode": {
          "enum": [
            "primary",
            "dual",
            "rainbow",
            "cyan_magenta",
            "emerald_gold",
            "crimson_ice"
          ]
        },
        "strobe": {
          "$ref": "#/$defs/unit"
        },
        "audienceScan": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "intensity",
        "pattern",
        "beamCount",
        "spreadX",
        "spreadY",
        "speed",
        "tilt",
        "rotation",
        "colorMode",
        "strobe",
        "audienceScan"
      ],
      "additionalProperties": false
    },
    "motorTarget": {
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/unit"
        },
        "tilt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "height",
        "tilt"
      ],
      "additionalProperties": false
    },
    "motors": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "high",
            "low",
            "v_tilt",
            "wave",
            "drop",
            "breathe"
          ]
        },
        "speed": {
          "$ref": "#/$defs/unit"
        },
        "podTargets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/motorTarget"
          },
          "maxProperties": 64,
          "description": "Keys must match truss pod IDs in the rig."
        }
      },
      "required": [
        "mode",
        "speed",
        "podTargets"
      ],
      "additionalProperties": false
    },
    "atmo": {
      "type": "object",
      "properties": {
        "hazeLevel": {
          "$ref": "#/$defs/unit"
        },
        "smokeOutput": {
          "$ref": "#/$defs/unit"
        },
        "co2Active": {
          "type": "boolean"
        },
        "co2AutoOnDrop": {
          "type": "boolean"
        }
      },
      "required": [
        "hazeLevel",
        "smokeOutput",
        "co2Active",
        "co2AutoOnDrop"
      ],
      "additionalProperties": false
    },
    "led": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "brightness": {
          "$ref": "#/$defs/unit"
        },
        "visualMode": {
          "enum": [
            "tunnel",
            "cybergrid",
            "spectrum",
            "plasma",
            "strobe_bars",
            "mandala",
            "tour_text",
            "custom"
          ]
        },
        "speed": {
          "$ref": "#/$defs/unit"
        },
        "tourText": {
          "type": "string",
          "maxLength": 4096
        },
        "customMediaUrl": {
          "type": "null",
          "description": "Session media must be selected again after opening the file."
        },
        "customMediaType": {
          "type": "null"
        }
      },
      "required": [
        "enabled",
        "brightness",
        "visualMode",
        "speed",
        "tourText",
        "customMediaUrl",
        "customMediaType"
      ],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "tag": {
          "type": "string",
          "maxLength": 128
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "followSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "description": "Seconds to hold before advancing to the following cue. Omit for a manual hold."
        },
        "state": {
          "$ref": "#/$defs/cueState"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "required": [
        "id",
        "name",
        "tag",
        "accent",
        "state"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "properties": {
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "volume": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "camera",
        "volume"
      ],
      "additionalProperties": false
    },
    "camera": {
      "enum": [
        "foh",
        "front_row",
        "wide_arena",
        "stage_side",
        "overhead",
        "orbit",
        "pa_closeup"
      ]
    },
    "mediaName": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!\\s*[a-zA-Z][a-zA-Z0-9+.-]*:)[^/\\\\\\u0000-\\u001f\\u007f]*$",
      "description": "Display name or basename only. Use an empty string when no source is selected. Media bytes, device credentials, paths and URLs are never embedded."
    },
    "seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "music": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "demo",
            "file",
            "live",
            "none"
          ]
        },
        "name": {
          "$ref": "#/$defs/mediaName"
        },
        "playing": {
          "type": "boolean"
        },
        "offsetSeconds": {
          "$ref": "#/$defs/seconds"
        },
        "demoStep": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024,
          "description": "Position in sixteenth notes of the built-in 64-bar score."
        }
      },
      "required": [
        "kind",
        "name",
        "playing"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "demo",
              "file",
              "live"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "properties": {
        "target": {
          "const": "main-led"
        },
        "kind": {
          "enum": [
            "video",
            "image",
            "none"
          ]
        },
        "name": {
          "$ref": "#/$defs/mediaName"
        },
        "playing": {
          "type": "boolean"
        },
        "offsetSeconds": {
          "$ref": "#/$defs/seconds"
        }
      },
      "required": [
        "target",
        "kind",
        "name",
        "playing"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "video",
              "image"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "music": {
          "$ref": "#/$defs/music"
        },
        "screen": {
          "$ref": "#/$defs/screen"
        }
      },
      "required": [
        "music",
        "screen"
      ],
      "additionalProperties": false
    },
    "bump": {
      "type": "object",
      "properties": {
        "blinder": {
          "type": "boolean"
        },
        "strobe": {
          "type": "boolean"
        },
        "co2": {
          "type": "boolean"
        },
        "smoke": {
          "type": "boolean"
        },
        "laser": {
          "type": "boolean"
        },
        "motorDrop": {
          "type": "boolean"
        }
      },
      "required": [
        "blinder",
        "strobe",
        "co2",
